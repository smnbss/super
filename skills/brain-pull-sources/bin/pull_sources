#!/bin/bash
# Pull all sources listed in one or more sources files — PARALLEL.
#
# Usage:
#   pull_sources                       # default: reads sources.md AND sources.github.md
#   pull_sources sources.md            # one explicit file
#   pull_sources a.md b.md             # several explicit files, in order
#
# Sources are split across two files by where their output lands:
#   sources.md          -> non-GitHub sources, exported into  src/<source>/
#   sources.github.md   -> github_clone repos,  cloned   into  github/<owner>/<repo>/
#
# Parallelism model (why it's safe):
#   - Commands of the SAME tool (e.g. two `clickup_doc_to_md`) share one registry
#     file (src/<tool>/.registry.json), so they run SERIALLY within a per-tool lane.
#   - Different tools touch different registries, so their lanes run CONCURRENTLY.
#   - `github_clone` has no shared state (each repo is an independent git dir), so
#     every repo gets its own lane and they all run concurrently.
#   - All lanes run through a global concurrency cap (GBRAIN_PULL_PAR, default 8)
#     via `xargs -P` (portable to macOS bash 3.2 — no `wait -n`).

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel)"
MAX_PAR="${GBRAIN_PULL_PAR:-8}"

# Build the list of sources files to process.
if [[ $# -gt 0 ]]; then
  SOURCES_FILES=("$@")
else
  SOURCES_FILES=("$REPO_ROOT/sources.md" "$REPO_ROOT/sources.github.md")
fi

# Load .env.local if present (tokens and secrets)
if [[ -f "$REPO_ROOT/.env.local" ]]; then
  set -a
  source "$REPO_ROOT/.env.local"
  set +a
fi

TMP="$(mktemp -d "${TMPDIR:-/tmp}/pull_sources.XXXXXX")"
LANES="$TMP/lanes"     # one file per lane; each line is a full command
RES="$TMP/res"         # one file per lane; "OK" / "FAIL: <cmd>" lines
mkdir -p "$LANES" "$RES"
trap 'rm -rf "$TMP"' EXIT

# --- Parse all sources files into lanes -------------------------------------
# (No associative arrays — macOS /bin/bash is 3.2. Counts are derived from the
#  lane files after parsing.)
gh_n=0
for sources_file in "${SOURCES_FILES[@]}"; do
  # Resolve a bare/relative path against the repo root.
  if [[ ! -f "$sources_file" && "$sources_file" != /* ]]; then
    sources_file="$REPO_ROOT/$sources_file"
  fi
  if [[ ! -f "$sources_file" ]]; then
    echo "Skipping (not found): $sources_file"
    continue
  fi

  while IFS= read -r line; do
    cmd="${line%%#*}"                           # strip inline comments
    cmd="${cmd%"${cmd##*[![:space:]]}"}"         # rtrim
    cmd="${cmd#"${cmd%%[![:space:]]*}"}"         # ltrim
    [[ -z "$cmd" ]] && continue
    tool="${cmd%% *}"

    if [[ ! -x "$SCRIPT_DIR/$tool" ]]; then
      echo "Unknown command: $tool — skipping"
      continue
    fi

    if [[ "$tool" == "github_clone" ]]; then
      # One lane per repo — fully parallel (no shared state).
      printf '%s\n' "$cmd" > "$LANES/gh_$gh_n"
      gh_n=$((gh_n + 1))
    else
      # One lane per tool — serial within (shared registry).
      printf '%s\n' "$cmd" >> "$LANES/tool_$tool"
    fi
  done < "$sources_file"
done

lane_count=$(find "$LANES" -type f 2>/dev/null | wc -l | tr -d ' ')
gh_lanes=$(find "$LANES" -name 'gh_*' -type f 2>/dev/null | wc -l | tr -d ' ')
tool_groups=$(find "$LANES" -name 'tool_*' -type f 2>/dev/null | wc -l | tr -d ' ')
if [[ "$lane_count" -eq 0 ]]; then
  echo "No sources to pull."
  exit 0
fi
echo "Pulling ${lane_count} lanes (${gh_lanes} github repos + ${tool_groups} tool groups), up to ${MAX_PAR} in parallel…"
echo ""

# --- Lane runner (invoked once per lane file by xargs) -----------------------
export SCRIPT_DIR RES
run_lane() {
  local lane_file="$1"
  local lane_name; lane_name="$(basename "$lane_file")"
  local res_file="$RES/$lane_name"
  : > "$res_file"
  while IFS= read -r cmd; do
    [[ -z "$cmd" ]] && continue
    local tool="${cmd%% *}"
    local args=""
    [[ "$cmd" == *" "* ]] && args="${cmd#* }"
    echo ">>> $cmd"
    if "$SCRIPT_DIR/$tool" $args > "$res_file.log" 2>&1; then
      echo "OK" >> "$res_file"
    else
      echo "FAIL: $cmd" >> "$res_file"
    fi
    # Surface the tail of each command's output (interleaved but attributed).
    sed "s|^|[$lane_name] |" "$res_file.log" | tail -3
    rm -f "$res_file.log"
  done < "$lane_file"
}
export -f run_lane

# --- Run all lanes through the concurrency cap -------------------------------
find "$LANES" -type f -print0 \
  | xargs -0 -P "$MAX_PAR" -I{} bash -c 'run_lane "$@"' _ {}

# --- Tally -------------------------------------------------------------------
success=$(grep -rh '^OK$'    "$RES" 2>/dev/null | wc -l | tr -d ' ')
failed=$( grep -rh '^FAIL: ' "$RES" 2>/dev/null | wc -l | tr -d ' ')

if [[ "$failed" -gt 0 ]]; then
  echo ""
  echo "Failures:"
  grep -rh '^FAIL: ' "$RES" 2>/dev/null | sed 's/^/  /'
fi

# Write export manifest for brain-sync
MANIFEST="$REPO_ROOT/src/.last_export.json"
NOW=$(date -u +%Y-%m-%dT%H:%M:%SZ)
mkdir -p "$REPO_ROOT/src"
{
  echo "{"
  echo "  \"timestamp\": \"$NOW\","
  echo "  \"success\": $success,"
  echo "  \"failed\": $failed"
  echo "}"
} > "$MANIFEST"

echo ""
echo "Done. $success succeeded, $failed failed."
echo "Manifest written to src/.last_export.json"

# --- Jungle-managed repos ----------------------------------------------------
# The local dev stack (jungle) owns its own repo list: github/weroad/jungle/
# bin/repos.sh. Rather than duplicate those repos in sources.github.md, we
# clone them NESTED under github/weroad/jungle/<repo>/ so the brain mirror
# matches the real jungle layout. We clone over HTTPS via github_clone (NOT
# jungle's own bin/repo.init.sh, which hardcodes git@github.com SSH and fails
# in non-interactive/scheduled contexts like morning-start). repos.sh stays the
# single source of truth — we only parse it, never copy the list.
JUNGLE_REPOS="$REPO_ROOT/github/weroad/jungle/bin/repos.sh"
if [[ -f "$JUNGLE_REPOS" ]]; then
  echo ""
  echo "Jungle repos (nested under github/weroad/jungle/, per jungle/bin/repos.sh)…"
  j_ok=0; j_fail=0
  # extract unique weroad/<name> from the REPOS=() array (handles .git suffix)
  jungle_names="$(grep -oE 'weroad/[a-z0-9-]+\.git' "$JUNGLE_REPOS" | sed -E 's#weroad/##; s#\.git$##' | sort -u)"
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    if "$SCRIPT_DIR/github_clone" "https://github.com/weroad/$name" "github/weroad/jungle/$name" >/dev/null 2>&1; then
      j_ok=$((j_ok + 1))
    else
      j_fail=$((j_fail + 1))
      echo "  FAIL: jungle/$name"
    fi
  done <<< "$jungle_names"
  echo "Jungle repos: $j_ok ok, $j_fail failed (github/weroad/jungle/)."
else
  echo ""
  echo "Jungle repos: skipped — github/weroad/jungle/bin/repos.sh not present yet."
fi

# --- Scope the gbrain link graph to curated pages ---------------------------
# The raw exports carry local-navigation markdown links (e.g. `[..](../INDEX.md)`,
# `[file](file.md)`) — kept intentionally so src/ stays browsable. But gbrain's
# `global_basename` resolution turns those into a multi-million-edge hairball
# (`INDEX.md` → every `index` page, etc.). After any (re)extraction, drop link
# edges that ORIGINATE from non-curated pages, keeping only the curated
# memory/ + outputs/ graph. Idempotent; safe to run every time; no-op if gbrain
# or psql aren't available (e.g. a thin checkout).
if command -v gbrain >/dev/null 2>&1 && command -v psql >/dev/null 2>&1; then
  DSN="$(gbrain config show 2>/dev/null | sed -n 's/^ *database_url: *//p')"
  if [[ -n "$DSN" ]]; then
    if psql "$DSN" -c "DELETE FROM links WHERE from_page_id NOT IN (SELECT id FROM pages WHERE slug LIKE 'memory/%' OR slug LIKE 'outputs/%');" >/dev/null 2>&1; then
      echo "Scoped gbrain link graph to curated pages (memory/ + outputs/)."
    fi
  fi
fi
