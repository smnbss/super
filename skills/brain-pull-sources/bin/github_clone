#!/bin/bash
# Full-clone or update a GitHub repo into github/<owner>/<repo>/
# Usage: github_clone <github_repo_url> [target_reldir]
#
# If the repo already exists locally, pulls latest changes.
# If not, does a full clone.
#
# Optional [target_reldir] (relative to the project root) overrides the default
# github/<owner>/<repo> destination — used to nest jungle repos under
# github/weroad/jungle/<repo>/ (see bin/pull_sources).
#
# Auth: uses local git/gh credential helper (no separate token needed).

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(git rev-parse --show-toplevel)"
OUTPUT_BASE="$PROJECT_ROOT/github"

# --- Deviation reporting -----------------------------------------------------
# Anything other than a clean mirror update has to be surfaced in the daily
# update, and stdout cannot carry it: each repo runs in its own process
# (pull_sources fans out with `xargs -P`), and the jungle loop redirects this
# script's output to /dev/null. So deviations are appended to a report file that
# pull_sources truncates at the start of a run and prints at the end.
# One `printf` per line keeps concurrent appends from interleaving on a local FS.
REPORT="${GITHUB_CLONE_REPORT:-$PROJECT_ROOT/.github-clone-report.md}"

report_line() {
  printf -- '- **%s** — %s\n' "$1" "$2" >> "$REPORT" 2>/dev/null || true
}

# --- Changed-repo ledger -----------------------------------------------------
# Everything downstream of the clone (service docs, technologies.md, freshness
# checks) only ever needs the repos whose HEAD actually MOVED. Deriving that
# later means re-walking 136 clones with an LLM in the loop; deriving it here is
# two `rev-parse` calls we are already paying for. So record it: one TSV line per
# repo that moved, written at the point where the before/after SHAs are both
# known. Same append-per-line discipline as the report (parallel lanes).
#
#   <owner>/<repo>\t<reldir>\t<before_sha>\t<after_sha>
#
# `before_sha` is `NEW` for a fresh or re-clone. A repo that did not move writes
# NOTHING — an empty ledger is the signal that a consumer can skip entirely.
CHANGED="${GITHUB_CLONE_CHANGED:-$PROJECT_ROOT/.github-changed-repos.tsv}"

changed_line() {
  printf -- '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" >> "$CHANGED" 2>/dev/null || true
}

URL="$1"
TARGET_RELDIR="$2"
if [[ -z "$URL" ]]; then
  echo "Usage: github_clone <github_repo_url> [target_reldir]"
  exit 1
fi

# Parse owner/repo from URL
# Handles: https://github.com/owner/repo, https://github.com/owner/repo.git,
#           https://github.com/owner/repo/tree/main/docs
OWNER=$(echo "$URL" | sed -E 's|https?://github\.com/([^/]+)/.*|\1|')
REPO=$(echo "$URL" | sed -E 's|https?://github\.com/[^/]+/([^/.]+).*|\1|')

if [[ -z "$OWNER" || -z "$REPO" ]]; then
  echo "ERROR: Could not parse GitHub URL: $URL"
  echo "Expected format: https://github.com/<owner>/<repo>"
  exit 1
fi

if [[ -n "$TARGET_RELDIR" ]]; then
  TARGET="$PROJECT_ROOT/$TARGET_RELDIR"
else
  TARGET="$OUTPUT_BASE/$OWNER/$REPO"
fi
CLONE_URL="https://github.com/$OWNER/$REPO.git"

# Path as the brain refers to it, and the SHA before we touch anything — both
# needed for the changed-repo ledger written at the end.
TARGET_REL="${TARGET#$PROJECT_ROOT/}"
BEFORE_SHA="$(git -C "$TARGET" rev-parse HEAD 2>/dev/null || echo NEW)"

if [[ -d "$TARGET/.git" ]]; then
  # Repo exists — pull latest
  echo "Updating $OWNER/$REPO..."
  cd "$TARGET"

  # If this was a shallow clone, unshallow it first
  if [[ -f .git/shallow ]]; then
    echo "  Converting shallow clone to full clone..."
    git fetch --unshallow origin 2>/dev/null || true
  fi

  DEFAULT_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||')
  if [[ -z "$DEFAULT_BRANCH" ]]; then
    DEFAULT_BRANCH="main"
  fi

  # --- Local work detection --------------------------------------------------
  # These clones are mirrors, but people do real work in them (a spec committed
  # on a branch, a repair in progress). A blind `reset --hard origin/<default>`
  # silently destroys that: it discards uncommitted changes AND moves the current
  # branch pointer, so committed work on a feature branch disappears too. So:
  # look before overwriting, and prefer merging to resetting whenever there is
  # anything local to lose.
  # ...but not everything dirty is "work". A TRACKED local-config file that the
  # dev stack rewrites — `deploy/*.env` — is edited on every developer machine and
  # committed on none, so treating it as local work freezes the clone PERMANENTLY:
  # dirty -> skipped -> never updated -> dirty again tomorrow. Measured 2026-08-14:
  # eight jungle clones stuck at 2026-08-07, api-catalog 57 commits behind main,
  # my 24, booking 17, community 11 — every one of them dirty on nothing but a
  # deploy/*.env file. Their service docs were therefore being written from
  # week-old code.
  #
  # So classify the dirt. Noise-only -> stash, update, restore. Anything else ->
  # skip, exactly as before. Only " M " (tracked, modified, unstaged) can be
  # noise; staged, deleted, renamed and untracked entries all stay "real work",
  # because those are shapes a human made deliberately.
  NOISE_RE='(^|/)deploy/[^/]*\.env$'
  DIRTY_RAW="$(git status --porcelain 2>/dev/null)"
  DIRTY=""; NOISE=""
  if [[ -n "$DIRTY_RAW" ]]; then
    NON_MODIFIED="$(printf '%s\n' "$DIRTY_RAW" | grep -v '^ M ' || true)"
    NON_NOISE="$(printf '%s\n' "$DIRTY_RAW" | grep '^ M ' | sed 's/^ M //' \
                  | grep -vE "$NOISE_RE" || true)"
    if [[ -n "$NON_MODIFIED" || -n "$NON_NOISE" ]]; then DIRTY="yes"; else NOISE="yes"; fi
  fi
  CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"

  if git fetch origin 2>/dev/null; then
    # Commits reachable from HEAD but not from the remote default branch. Counted
    # after the fetch so the comparison is against the freshly-updated remote.
    AHEAD="$(git rev-list --count "origin/$DEFAULT_BRANCH..HEAD" 2>/dev/null || echo 0)"

    # Park noise-only dirt so the ladder below sees a clean tree, then put it back.
    # Stashed AFTER the fetch succeeded on purpose: the fetch-failure path can
    # `rm -rf` the clone, and a stash lives inside .git, so stashing earlier would
    # put the developer's local config somewhere that path deletes.
    STASHED=""
    if [[ -n "$NOISE" ]]; then
      if git stash push --quiet -m "github_clone: local dev config, restored automatically" 2>/dev/null; then
        STASHED="yes"
      else
        # Could not park it — fall back to the old behaviour rather than risk it.
        echo "⚠ $OWNER/$REPO (could not stash local dev config — left untouched)"
        report_line "$OWNER/$REPO" "skipped — local dev config present and could not be stashed"
        exit 0
      fi
    fi

    if [[ -n "$DIRTY" ]]; then
      # Uncommitted changes: touch nothing at all. Merging would refuse or
      # clobber, and stashing on someone's behalf hides work where they will not
      # look for it.
      echo "⚠ $OWNER/$REPO (uncommitted changes — left untouched)"
      report_line "$OWNER/$REPO" "skipped — uncommitted changes on \`$CURRENT_BRANCH\`, not updated"

    elif [[ "$AHEAD" -gt 0 ]]; then
      # Local commits: merge the remote in rather than resetting over them.
      if git merge --no-edit "origin/$DEFAULT_BRANCH" >/dev/null 2>&1; then
        echo "✓ $OWNER/$REPO (merged origin/$DEFAULT_BRANCH into $CURRENT_BRANCH, $AHEAD local commit(s) kept)"
        report_line "$OWNER/$REPO" "merged \`origin/$DEFAULT_BRANCH\` into \`$CURRENT_BRANCH\` — $AHEAD local commit(s) preserved"
      else
        # Leave the tree exactly as it was and say so; a half-merged mirror is
        # worse than a stale one.
        git merge --abort >/dev/null 2>&1
        echo "⚠ $OWNER/$REPO (merge conflict — left at $CURRENT_BRANCH, not updated)"
        report_line "$OWNER/$REPO" "**merge conflict** — \`origin/$DEFAULT_BRANCH\` could not be merged into \`$CURRENT_BRANCH\`; $AHEAD local commit(s) intact, needs a manual merge"
      fi

    elif [[ "$CURRENT_BRANCH" != "$DEFAULT_BRANCH" ]]; then
      # On a branch with nothing of its own — fast-forwardable, so just move it.
      if git merge --ff-only "origin/$DEFAULT_BRANCH" >/dev/null 2>&1; then
        echo "✓ $OWNER/$REPO (fast-forwarded $CURRENT_BRANCH)"
      else
        echo "⚠ $OWNER/$REPO (on $CURRENT_BRANCH, cannot fast-forward — not updated)"
        report_line "$OWNER/$REPO" "skipped — on \`$CURRENT_BRANCH\` and not fast-forwardable"
      fi

    else
      # The ordinary mirror case: pristine clone on the default branch.
      if git reset --hard "origin/$DEFAULT_BRANCH" 2>/dev/null; then
        echo "✓ $OWNER/$REPO (updated)"
      else
        echo "✗ $OWNER/$REPO (reset failed)"
        exit 1
      fi
    fi
    # Restore the parked dev config. A conflict here means upstream changed the
    # same env file: keep the stash rather than dropping it, and say so loudly —
    # the local values are recoverable with `git stash pop` but the clone is now
    # carrying upstream's version.
    if [[ -n "$STASHED" ]]; then
      if git stash pop --quiet 2>/dev/null; then
        :
      else
        git checkout --theirs . >/dev/null 2>&1 || true
        echo "⚠ $OWNER/$REPO (updated, but local dev config conflicts with upstream — kept in \`git stash\`)"
        report_line "$OWNER/$REPO" "updated, but local \`deploy/*.env\` could NOT be restored (upstream changed the same file) — your values are preserved: run \`git stash pop\` in \`$TARGET\`"
      fi
    fi

  else
    # Fetch failed. Re-cloning means `rm -rf`, so it is only ever safe on a clone
    # with nothing local in it — otherwise the recovery is more destructive than
    # the problem it fixes. NOISE counts as local: a deploy/*.env holds the
    # developer's local ports and credentials, and rm -rf takes it with no copy.
    if [[ -n "$DIRTY" || -n "$NOISE" || "$CURRENT_BRANCH" != "$DEFAULT_BRANCH" ]]; then
      echo "⚠ $OWNER/$REPO (fetch failed — has local work, NOT re-cloned)"
      report_line "$OWNER/$REPO" "fetch failed and local work present (\`$CURRENT_BRANCH\`${DIRTY:+, uncommitted changes}${NOISE:+, local \`deploy/*.env\`}) — left as-is instead of re-cloning"
    else
      echo "⚠ $OWNER/$REPO (fetch failed, re-cloning)"
      cd "$PROJECT_ROOT"
      rm -rf "$TARGET"
      if git clone "$CLONE_URL" "$TARGET" 2>/dev/null; then
        echo "✓ $OWNER/$REPO (re-cloned)"
      else
        echo "✗ $OWNER/$REPO (clone failed)"
        exit 1
      fi
    fi
  fi
else
  # Fresh clone
  mkdir -p "$(dirname "$TARGET")"
  echo "Cloning $OWNER/$REPO..."
  if git clone "$CLONE_URL" "$TARGET" 2>/dev/null; then
    echo "✓ $OWNER/$REPO (cloned)"
  else
    echo "✗ $OWNER/$REPO (clone failed — may not exist or no access)"
    exit 1
  fi
fi

# --- Record whether this repo moved -----------------------------------------
# Reached only on success (every failure path above exits non-zero), so a line
# here always means "this working tree is at a new commit". Skipped repos and
# no-op updates deliberately write nothing.
AFTER_SHA="$(git -C "$TARGET" rev-parse HEAD 2>/dev/null || echo '')"
if [[ -n "$AFTER_SHA" && "$AFTER_SHA" != "$BEFORE_SHA" ]]; then
  changed_line "$OWNER/$REPO" "$TARGET_REL" "$BEFORE_SHA" "$AFTER_SHA"
fi
