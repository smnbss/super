#!/usr/bin/env bash
# Resync super's canonical skills/ into every vendored copy.
#
# WHY THIS IS A SCRIPT: this is mechanical work that was being done by an LLM every
# morning -- 4.3M tokens on 2026-08-18 to apply one version bump and rsync a drifted
# copy, and the same drift appeared four mornings running. It is a diff and a copy.
#
# WHY IT IS NOT A SYMLINK: a vendored copy can be a COMBINED tree that holds other
# people's skills alongside super's, outnumbering them by an order of magnitude.
# Symlinking or `rsync --delete` at the tree level would destroy them, so this syncs
# PER SKILL DIRECTORY and never deletes.
#
# Usage:
#   resync-vendored-skills            # report drift and fix it
#   resync-vendored-skills --check    # report only; exit 1 if any copy has drifted
#
# Exit: 0 = all copies in sync (or fixed). 1 = drift found (--check) or unfixable.

set -uo pipefail

CANON_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CANON="$CANON_ROOT/skills"
CHECK_ONLY=0
[[ "${1:-}" == "--check" ]] && CHECK_ONLY=1

[[ -d "$CANON" ]] || { echo "resync: no canonical skills/ at $CANON" >&2; exit 1; }

# Known vendored copies. A missing one is skipped, not an error -- not every machine
# has a brain checkout.
#
# DELIBERATELY LOCAL-ONLY: never add a cloud-synced or removable path here (a Drive /
# Dropbox / iCloud mount, an external volume). Writing a skill into a synced folder
# UPLOADS it, and these skills carry internal detail that must not leave the machine
# on someone's personal account. Enumerate real local install roots only.
CANDIDATES=(
  "$HOME/.super/skills"
  "$HOME/.claude/skills"
  "$HOME/.agents/skills"
  "$HOME/.codex/skills"
  "$HOME/.gemini/skills"
)
# A brain checkout keeps its own copy. Finding it via a bare `$PWD/.claude/skills`
# test made the whole run cwd-dependent: invoked from anywhere but the brain root --
# from $SUPER_HOME, or from any SUBDIRECTORY of the brain -- it silently checked one
# fewer copy and still printed a clean all-clear. Resolve it properly instead:
#   1. $BRAIN_ROOT / $SUPER_PROJECT_DIR when set (same override super itself honours)
#   2. walk UP from $PWD for a brain marker, so a subdirectory works
#   3. the brain that owns this script, when $SUPER_HOME is a sibling checkout
# and then refuse to exit 0 having checked nothing (see the tail of this script).
brain_root() {
  local d
  for d in "${BRAIN_ROOT:-}" "${SUPER_PROJECT_DIR:-}"; do
    [[ -n "$d" && -d "$d/.agents/skills" ]] && { printf '%s\n' "$d"; return 0; }
  done
  d="$PWD"
  local canon_root="${SUPER_HOME:-$HOME/.super}"
  while [[ "$d" != "/" && -n "$d" ]]; do
    # $HOME itself has BOTH markers on a normal machine ($HOME/.super is the
    # super install, $HOME/.agents/skills holds other people's skills), so the
    # walk must never accept it -- nor the super install dir. super's own
    # cmdInstall refuses these two roots for the same reason.
    if [[ "$d" != "$HOME" && "$d" != "$canon_root" ]] \
       && [[ -d "$d/.super" && -d "$d/.agents/skills" ]]; then
      printf '%s\n' "$d"; return 0
    fi
    d="$(dirname "$d")"
  done
  return 1
}
BRAIN="$(brain_root || true)"
[[ -n "$BRAIN" && -d "$BRAIN/.claude/skills" ]] && CANDIDATES+=("$BRAIN/.claude/skills")
[[ -n "$BRAIN" && -d "$BRAIN/.agents/skills" ]] && CANDIDATES+=("$BRAIN/.agents/skills")

EXCL=(--exclude='__pycache__' --exclude='.DS_Store' --exclude='*.pyc')
drifted=0; fixed=0; checked=0

for dest in "${CANDIDATES[@]}"; do
  [[ -d "$dest" ]] || continue
  # De-dup: the same dir can be reached by two paths.
  real="$(cd "$dest" && pwd -P)"
  [[ "$real" == "$(cd "$CANON" && pwd -P)" ]] && continue
  case " ${seen:-} " in *" $real "*) continue ;; esac
  seen="${seen:-} $real"

  # ONLY sync copies that ALREADY carry super's skills. ~/.claude/skills,
  # ~/.agents/skills and ~/.codex/skills all exist on a normal machine and hold
  # OTHER skills (gstack, plugins) with zero super skills among them -- treating
  # those as sync targets would silently perform a new global install of 19
  # skills nobody asked for, not a resync.
  established=0
  for d in "$CANON"/*/; do
    [[ -d "$dest/$(basename "$d")" ]] && { established=1; break; }
  done
  if [[ "$established" -eq 0 ]]; then
    printf '  – %-58s not a super distribution target (skipped)\n' "${dest/#$HOME/~}"
    continue
  fi
  checked=$((checked+1))

  # Only compare skills that exist canonically; ignore extra skills in the copy.
  diffs=0; newer=0
  for d in "$CANON"/*/; do
    name="$(basename "$d")"
    [[ -d "$dest/$name" ]] || { diffs=$((diffs+1)); echo "  · missing skill: $name" >&2; continue; }
    if ! diff -rq "${EXCL[@]}" "$d" "$dest/$name" >/dev/null 2>&1; then
      diffs=$((diffs+1))
      # Warn if the COPY is newer -- that is a local edit about to be overwritten.
      while IFS= read -r f; do
        rel="${f#$dest/$name/}"
        [[ -f "$d/$rel" ]] || continue
        [[ "$f" -nt "$d/$rel" ]] && { echo "  ⚠ copy is NEWER: $name/$rel" >&2; newer=$((newer+1)); }
      done < <(find "$dest/$name" -type f -name '*.md' -o -type f -name '*.py' 2>/dev/null)
    fi
  done

  label="${dest/#$HOME/~}"
  if [[ "$diffs" -eq 0 ]]; then
    printf '  ✓ %-58s in sync\n' "$label"
    continue
  fi
  drifted=$((drifted+1))
  printf '  ✗ %-58s %s skill(s) drifted\n' "$label" "$diffs"
  if [[ "$newer" -gt 0 ]]; then
    echo "    NOT syncing: $newer file(s) in the copy are newer than canonical." >&2
    echo "    Resolve by hand — a vendored copy is not supposed to be edited." >&2
    continue
  fi
  if [[ "$CHECK_ONLY" -eq 1 ]]; then
    continue
  fi
  for d in "$CANON"/*/; do
    name="$(basename "$d")"
    mkdir -p "$dest/$name"
    rsync -a "${EXCL[@]}" "$d" "$dest/$name/" || {
      echo "    rsync failed for $name" >&2; continue; }
  done
  # Re-verify rather than trusting rsync's exit status.
  post=0
  for d in "$CANON"/*/; do
    name="$(basename "$d")"
    diff -rq "${EXCL[@]}" "$d" "$dest/$name" >/dev/null 2>&1 || post=$((post+1))
  done
  if [[ "$post" -eq 0 ]]; then printf '    → resynced, verified in sync\n'; fixed=$((fixed+1))
  else printf '    → STILL DRIFTED after resync: %s skill(s)\n' "$post" >&2; fi
done

echo "resync: $checked copy(ies) checked · $drifted drifted · $fixed fixed"

# Checking NOTHING is a failure, not a pass. This used to print "0 copy(ies)
# checked · 0 drifted" and exit 0 -- indistinguishable from "everything is in
# sync", which is how a cwd-dependent run reported success while verifying
# nothing at all.
if [[ "$checked" -eq 0 ]]; then
  {
    echo "resync: FAILED — no distribution copy was checked, so nothing was verified."
    echo "  Canonical: $CANON"
    if [[ -z "$BRAIN" ]]; then
      echo "  No brain checkout found from \$PWD ($PWD)."
      echo "  Run this from inside your brain, or set BRAIN_ROOT=/path/to/brain."
    else
      echo "  Brain found at $BRAIN but it carries none of super's skills yet."
      echo "  Run 'super install all --skills-only' from there first."
    fi
  } >&2
  exit 1
fi

if [[ "$CHECK_ONLY" -eq 1 && "$drifted" -gt 0 ]]; then exit 1; fi
if [[ "$drifted" -gt 0 && "$fixed" -lt "$drifted" ]]; then exit 1; fi
exit 0
